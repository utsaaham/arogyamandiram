# Copy this file before editing it:
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/arogyamandiram
MONGO_DB=arogyamandiram

# -----------------------------------------------------------------------------
# Authentication (required)
# NEXTAUTH_URL must use the same port as PORT during local development.
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:30000
NEXTAUTH_SECRET=MiBDeF0fZ1IwKk1DXVumM42hfuBtA+p5HzwtzFadlng=

# -----------------------------------------------------------------------------
# Sensitive-data encryption (required)
# ENCRYPTION_KEY must be a 32-byte hexadecimal key.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

# -----------------------------------------------------------------------------
# Scheduled jobs (required)
# Protects cron endpoints and authenticated internal requests.
# -----------------------------------------------------------------------------
CRON_SECRET=replace-with-at-least-32-random-characters

# -----------------------------------------------------------------------------
# Local runtime and public application metadata (optional)
# Keep NEXTAUTH_URL in sync when PORT changes.
# -----------------------------------------------------------------------------
PORT=30000
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DASHBOARD_TOUR_VERSION=1

# -----------------------------------------------------------------------------
# Pydantic Logfire (optional)
# LOGFIRE_TOKEN is server-only. Never rename it with a NEXT_PUBLIC_ prefix.
# Enable browser telemetry only after a valid token is configured.
# -----------------------------------------------------------------------------
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
NEXT_PUBLIC_LOGFIRE_BROWSER_ENABLED=false

# -----------------------------------------------------------------------------
# AI (optional server fallback; users may provide their own key in Settings)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_BEST=gpt-5.4
OPENAI_MODEL_ORCHESTRATOR=gpt-5.4-mini

# -----------------------------------------------------------------------------
# USDA FoodData Central (optional; DEMO_KEY has a lower rate limit)
# -----------------------------------------------------------------------------
FDC_API_KEY=DEMO_KEY
FOOD_CACHE_TTL_DAYS=30

# -----------------------------------------------------------------------------
# User-configured reminder email defaults (optional)
# Users provide their mailbox address and app password in Settings.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# -----------------------------------------------------------------------------
# Authentication email sender (required for verification and password recovery)
# Use a dedicated account. These credentials must remain server-only.
# -----------------------------------------------------------------------------
AUTH_SMTP_HOST=smtp.gmail.com
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=security@example.com
AUTH_SMTP_PASS=replace-with-an-app-password
AUTH_EMAIL_FROM="Arogyamandiram Security <security@example.com>"
